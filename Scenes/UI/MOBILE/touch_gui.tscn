[sub_resource type="GDScript" id="GDScript_u8wbt"]
script/source = "extends Control

var swipe_buttons: Array[TouchScreenButton] = []
var active_touches: Dictionary = {}
var fired_pressed_actions: Dictionary = {} 

# NEW: Tracks the current toggle state of specific action buttons
var action_toggles: Dictionary = {
	\"Sprint\": false
}

func _ready() -> void:
	find_touch_buttons(self)
	visible = true

func find_touch_buttons(current_node: Node) -> void:
	for child in current_node.get_children():
		if child is TouchScreenButton:
			swipe_buttons.append(child)
		else:
			find_touch_buttons(child)

func _input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if event.pressed:
			active_touches[event.index] = event.position
		else:
			active_touches.erase(event.index)
		update_button_states()
		
	elif event is InputEventScreenDrag:
		active_touches[event.index] = event.position
		update_button_states()
		
	elif event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT:
			if event.pressed:
				active_touches[-1] = event.position
			else:
				active_touches.erase(-1)
			update_button_states()
			
	elif event is InputEventMouseMotion:
		if active_touches.has(-1):
			active_touches[-1] = event.position
			update_button_states()

func update_button_states() -> void:
	var active_actions: Dictionary = {}
	var buttons_touched: Dictionary = {}

	for button : TouchScreenButton in swipe_buttons:
		if not button.is_visible_in_tree() or button.texture_normal == null:
			continue
			
		var rect: Rect2 = Rect2(Vector2.ZERO, button.texture_normal.get_size())
		var touch_inside : bool = false
		
		for touch_index in active_touches:
			var touch_pos = active_touches[touch_index]
			var local_pos = button.to_local(touch_pos)
			if rect.has_point(local_pos):
				touch_inside = true
				break
				
		buttons_touched[button] = touch_inside
		if touch_inside and button.action != \"\":
			active_actions[button.action] = true

	for button in swipe_buttons:
		var touch_inside = buttons_touched.get(button, false)
		var should_be_active = touch_inside or active_actions.get(button.action, false)
		
		if should_be_active:
			if button.action != \"\":
				if not fired_pressed_actions.get(button.action, false):
					fired_pressed_actions[button.action] = true
					
					# SPECIAL TOGGLE HANDLING
					if action_toggles.has(button.action):
						# Flip the toggle state internally
						action_toggles[button.action] = not action_toggles[button.action]
						# Send the true or false state explicitly to the player routing engine
						_parse_dynamic_event(button.action, action_toggles[button.action])
					else:
						# Standard immediate button action (Dash, Punch)
						_parse_dynamic_event(button.action, true)
					
					if button.has_method(\"_on_pressed\"): button._on_pressed()
					button.emit_signal(\"pressed\")
		else:
			if button.action != \"\":
				if fired_pressed_actions.get(button.action, false):
					fired_pressed_actions[button.action] = false
					
					# Only clear non-toggle buttons on release
					if not action_toggles.has(button.action):
						_parse_dynamic_event(button.action, false)
						
					if button.has_method(\"_on_released\"): button._on_released()
					button.emit_signal(\"released\")

func _parse_dynamic_event(action_name: String, is_pressed: bool) -> void:
	var iea := InputEventAction.new()
	iea.action = action_name
	iea.pressed = is_pressed
	Input.parse_input_event(iea)
"

