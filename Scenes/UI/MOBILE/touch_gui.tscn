[sub_resource type="GDScript" id="GDScript_u8wbt"]
script/source = "extends Control

func disable_all_buttons():
	# Fetch every single descendant node recursively
	var everything = get_children(true)
	
	for node in everything:
		# Check if the node inherits from the Button class
		if node is Button:
			node.disabled = true

func _ready() -> void:
	disable_all_buttons()"

